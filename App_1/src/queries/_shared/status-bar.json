{
    "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
    "width": "container",
    "height": "container",
    "encoding": {
        "y": {
            "field": "Claim_Status",
            "type": "nominal",
            "sort": ["Open", "Under Review", "Closed"],
            "axis": { "title": null, "labelFontWeight": 600 }
        },
        "x": {
            "field": "Amount",
            "type": "quantitative",
            "axis": { "title": null, "grid": false }
        },
        "color": {
            "field": "Claim_Status",
            "type": "nominal",
            "scale": {
                "domain": ["Open", "Under Review", "Closed"],
                "range": ["#b7791f", "#2563eb", "#15803d"]
            },
            "legend": null
        }
    },
    "layer": [
        { "mark": { "type": "bar", "cornerRadiusEnd": 4, "tooltip": true } },
        {
            "mark": { "type": "text", "style": "labelHorizontal" },
            "encoding": {
                "text": { "field": "Amount", "type": "quantitative" }
            }
        }
    ]
}
