EVALUATE
ADDCOLUMNS(
    GROUPBY(
        ADDCOLUMNS(
            'Claims',
            "MonthStart", DATE(YEAR('Claims'[Claim Date]), MONTH('Claims'[Claim Date]), 1)
        ),
        [MonthStart],
        "ClaimCount", SUMX(CURRENTGROUP(), 1),
        "TotalAmount", SUMX(CURRENTGROUP(), 'Claims'[Claim Amount]),
        "OpenCount", SUMX(CURRENTGROUP(), IF('Claims'[Claim Status] = "Open", 1, 0)),
        "Exposure", SUMX(CURRENTGROUP(), IF('Claims'[Claim Status] = "Closed", 0, 'Claims'[Claim Amount]))
    ),
    "MonthLabel", FORMAT([MonthStart], "MMM YYYY")
)
ORDER BY [MonthStart]
