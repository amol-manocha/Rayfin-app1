EVALUATE
TOPN(
    8,
    SUMMARIZECOLUMNS(
        'Customer'[Customer ID],
        'Customer'[Customer Name],
        'Customer'[City],
        'Customer'[State],
        "ClaimCount", [Claim Count],
        "TotalAmount", [Total Claim Amount]
    ),
    [ClaimCount], DESC
)
ORDER BY [ClaimCount] DESC
