EVALUATE
ADDCOLUMNS(
    GROUPBY(
        ADDCOLUMNS(
            'Claims',
            "MonthStart", DATE(YEAR('Claims'[Claim Date]), MONTH('Claims'[Claim Date]), 1)
        ),
        [MonthStart],
        "ClaimCount", SUMX(CURRENTGROUP(), 1),
        "TotalAmount", SUMX(CURRENTGROUP(), 'Claims'[Claim Amount])
    ),
    "MonthLabel", FORMAT([MonthStart], "MMM YYYY")
)
ORDER BY [MonthStart]
