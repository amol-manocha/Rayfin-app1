EVALUATE
SUMMARIZECOLUMNS(
    'Adjuster'[Adjuster ID],
    'Adjuster'[Adjuster Name],
    'Adjuster'[Region],
    'Adjuster'[Experience Years],
    "ClaimCount", [Claim Count],
    "OpenAmount", CALCULATE([Total Claim Amount], 'Claims'[Claim Status] = "Open")
)
ORDER BY 'Adjuster'[Adjuster Name] ASC
